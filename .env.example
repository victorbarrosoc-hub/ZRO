# Copie para .env.local e preencha. Nunca versione o .env.local.
# Na Vercel, cadastre em Settings → Environment Variables (passo a passo no DEPLOY.md).

# Endereço público do site (metadados, sitemap e links)
NEXT_PUBLIC_SITE_URL=https://zrofilmes.vercel.app

# Banco de dados
# Local (padrão): file:./data/zro.db
# Produção (Turso/libSQL): libsql://seu-banco.turso.io
# A integração da Turso na Vercel cria as próprias variáveis; o código também as reconhece.
DATABASE_URL=file:./data/zro.db
DATABASE_AUTH_TOKEN=

# Sessão da área interna: 32+ caracteres aleatórios (ex.: openssl rand -base64 48)
SESSION_SECRET=

# Contas dos sócios (criadas no deploy / npm run db:setup; senha com 10+ caracteres)
ZRO_VICTOR_EMAIL=
ZRO_VICTOR_PASSWORD=
ZRO_EDU_EMAIL=
ZRO_EDU_PASSWORD=

# Copie para .env.local e preencha. Nunca versione o .env.local.

# Endereço público do site (usado em links e metadados)
NEXT_PUBLIC_SITE_URL=https://zrofilmes.com.br

# Banco de dados
# Local (padrão): file:./data/zro.db
# Produção (Turso/libSQL): libsql://seu-banco.turso.io
DATABASE_URL=file:./data/zro.db
DATABASE_AUTH_TOKEN=

# Sessão da área interna: 32+ caracteres aleatórios (ex.: openssl rand -base64 32)
SESSION_SECRET=

# Acesso dos sócios (usado só por `npm run db:setup` para criar as contas)
ZRO_VICTOR_EMAIL=
ZRO_VICTOR_PASSWORD=
ZRO_EDU_EMAIL=
ZRO_EDU_PASSWORD=

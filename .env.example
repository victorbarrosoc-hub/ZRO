# Copie para .env.local e preencha. Nunca versione o .env.local.
# Na Vercel, cadastre em Settings → Environment Variables (passo a passo no DEPLOY.md).

# Endereço público do site (metadados, sitemap e links)
NEXT_PUBLIC_SITE_URL=https://zrofilmes.vercel.app

# Banco de dados (Postgres)
# Produção: a integração Neon da Vercel cria DATABASE_URL (com pooler). Outro Postgres serve.
# Local: deixe vazio. O `npm run dev` sobe o PGlite (data/pglite) e conecta sozinho.
DATABASE_URL=

# Sessão da área interna: 32+ caracteres aleatórios (ex.: openssl rand -base64 48)
SESSION_SECRET=

# Contas dos sócios (criadas no deploy / npm run db:setup; senha com 10+ caracteres)
ZRO_VICTOR_EMAIL=
ZRO_VICTOR_PASSWORD=
ZRO_EDU_EMAIL=
ZRO_EDU_PASSWORD=

# Google Drive (pastas, envios e área do cliente). Passo a passo no DEPLOY.md, seção 5.
# Cliente OAuth "Aplicativo da Web" do projeto "ZRO Site" no Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cifra dos segredos do Drive no banco: openssl rand -base64 32 (Sensitive na Vercel).
# No computador, vazio usa uma chave de desenvolvimento.
ZRO_DRIVE_KEY=
# Só no computador e nos testes (ignorada na Vercel e em produção): o Google falso.
# ZRO_GOOGLE_API_BASE=http://127.0.0.1:54400

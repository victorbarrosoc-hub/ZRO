{
  "name": "zro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "vercel-build": "tsx scripts/db-setup.mts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.mts",
    "db:seed": "tsx scripts/db-seed.mts",
    "db:setup": "tsx scripts/db-setup.mts",
